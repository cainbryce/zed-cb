#!/usr/bin/env bash
# Build/install flow for this fork of zed-industries/zed.
#
# `bootstrap` is the one-time machine setup: system packages, rust targets,
# compiler cache, target dir, git remotes, and the ~/.local/bin/zed-cb symlink
# that makes this script callable from anywhere. Everything after that is the
# day-to-day loop.
#
# Upstream main carries RELEASE_CHANNEL=dev, so this builds and installs as
# "Zed Devel" (dev.zed.Zed-Dev) into ~/.local/zed-dev.app. That path does not
# collide with ~/.local/zed.app, so an official tarball install can sit beside
# it. Every channel reads the same ~/.config/zed, so settings and keymap carry
# over; sqlite workspace state under ~/.local/share/zed/db is namespaced per
# channel (0-dev vs 0-stable).
#
#   zed-cb bootstrap     one-time machine setup (idempotent, safe to re-run)
#   zed-cb doctor        toolchain, deps, cache and disk report
#   zed-cb sync          bring main up to upstream/main, rebasing local commits
#   zed-cb run           debug build, run straight from the source tree
#   zed-cb build         release bundle -> zed-linux-<arch>.tar.gz
#   zed-cb install       unpack the bundle into ~/.local, wire up CLI + launcher
#   zed-cb update        sync + build + install
#   zed-cb link-default  point the generic `zed`/`zeditor` names at this build
#   zed-cb stats         sccache hit rate
#   zed-cb clean         drop the target dir
#
# Skip the portable musl remote_server build (only needed for SSH remoting):
#   ZED_CB_REMOTE_SERVER_TARGET=x86_64-unknown-linux-gnu zed-cb build

set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SRC="${ZED_CB_SRC:-$(dirname "$SELF")}"
PREFIX="${ZED_CB_PREFIX:-$HOME/.local}"
APP_DIR="$PREFIX/zed-dev.app"
CLI_NAME="${ZED_CB_CLI:-zed-cb}"
UPSTREAM_URL="https://github.com/zed-industries/zed.git"

# The target dir lives on nvme0n1p2 (mounted at ~/.cache), not the USB SSD that
# carries /home. Cargo's own fingerprint cache is the single biggest lever on
# rebuild time and it is very fsync-heavy, so it wants the fast disk.
export CARGO_TARGET_DIR="${ZED_CB_TARGET_DIR:-$HOME/.cache/cargo-target/zed-cb}"
TARGET_CAP_GB="${ZED_CB_TARGET_CAP_GB:-90}"

SCCACHE_BIN="${SCCACHE_BIN:-/usr/bin/sccache}"
# sccache reads this exact filename. A sibling config.toml is NOT read -- if one
# exists it is inert, and its size silently appearing correct just means it
# matched sccache's 10 GiB built-in default.
SCCACHE_CONF_FILE="$HOME/.config/sccache/config"
SCCACHE_DIR="${ZED_CB_SCCACHE_DIR:-$HOME/.cache/sccache}"
SCCACHE_SIZE_BYTES="${ZED_CB_SCCACHE_SIZE:-32212254720}" # 30 GiB
SCCACHE_BASEDIRS='["'"$HOME"'/Projects", "'"$HOME"'/Sources", "/mnt/games/.makepkg-build"]'

export RUSTC_WRAPPER="${RUSTC_WRAPPER:-$SCCACHE_BIN}"

# Extra flags go in through cargo's per-target variable, never RUSTFLAGS.
# RUSTFLAGS wins outright over every rustflags key in .cargo/config.toml --
# cargo picks one source, it does not merge them -- so setting it drops the
# repo's own flags, and script/bundle-linux now refuses to run with it set for
# exactly that reason. CARGO_TARGET_<TRIPLE>_RUSTFLAGS is the environment form
# of target.<triple>.rustflags, which cargo joins with the target.'cfg(..)'
# tables the repo and .cargo/bundle-config.toml declare. The same variable is
# set on the `run` path, so both paths hash to the same sccache keys.
#
# Only the host triple gets it: the musl remote_server keeps the linker
# upstream builds it with.
HOST_TRIPLE=$(rustc -vV 2>/dev/null | sed -n 's/^host: //p')
HOST_TRIPLE="${HOST_TRIPLE:-$(uname -m)-unknown-linux-gnu}"
HOST_RUSTFLAGS_VAR="CARGO_TARGET_$(printf '%s' "$HOST_TRIPLE" | tr 'a-z-' 'A-Z_')_RUSTFLAGS"
HOST_RUSTFLAGS="${ZED_CB_RUSTFLAGS:--C link-arg=-fuse-ld=mold}"
export "$HOST_RUSTFLAGS_VAR=$HOST_RUSTFLAGS"
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS

# codegen-units=1 + thin LTO on a ~1500-crate tree will take a 16 GB box past
# its RAM at -j12 and start thrashing swap; a single rustc here peaks near 9 GB.
export CARGO_BUILD_JOBS="${ZED_CB_JOBS:-6}"

export CC="${CC:-$(command -v clang || command -v cc)}"

# script/bundle-linux always builds crates/remote_server -- the binary Zed
# uploads to a host you open over SSH remoting. It defaults to the musl triple
# so that binary is static and runs on any remote distro, which costs a second
# full compile of the dependency tree against musl.
#
# If you never use remote development, or only ever remote into machines whose
# glibc is no older than this one, point it at the host triple instead: the
# gnu artifacts are already built, so remote_server becomes nearly free.
# bundle-linux handles this natively and just logs "Using non-musl
# remote-server build".
#
#   ZED_CB_REMOTE_SERVER_TARGET=x86_64-unknown-linux-gnu zed-cb build
#
# Leave it unset for the portable musl build. Either way the musl artifacts stay
# in the target dir once built, so the second musl build is not expensive.
[ -n "${ZED_CB_REMOTE_SERVER_TARGET:-}" ] &&
  export REMOTE_SERVER_TARGET="$ZED_CB_REMOTE_SERVER_TARGET"

msg()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> warning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m==> error:\033[0m %s\n' "$*" >&2; exit 1; }

need_src() {
  [ -d "$SRC/.git" ] || die "no checkout at $SRC (set ZED_CB_SRC)"
  cd "$SRC"
}

# An older script/bundle-linux exports RUSTFLAGS itself, which overrides the
# per-target variable above and links without mold or the repo's flags.
need_current_bundle_script() {
  if grep -q '^ *export RUSTFLAGS=' script/bundle-linux; then
    die "this checkout's script/bundle-linux still sets RUSTFLAGS; run '$CLI_NAME sync' first"
  fi
}

target_dir_gb() {
  [ -d "$CARGO_TARGET_DIR" ] || { echo 0; return; }
  du -sBG "$CARGO_TARGET_DIR" 2>/dev/null | cut -dG -f1
}

# A PID lock file, not a pgrep on the command line: matching "zed-cb build" as a
# string also matches any shell that merely mentions it, so a wrapper or a
# watcher loop reads as a live build and makes this guard refuse to act.
BUILD_LOCK="$CARGO_TARGET_DIR/.zed-cb-build.pid"

build_running() {
  [ -f "$BUILD_LOCK" ] || return 1
  local pid
  pid=$(cat "$BUILD_LOCK" 2>/dev/null) || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# ---------------------------------------------------------------- bootstrap --

# Package names are the Arch set from script/linux, plus two it does not list:
# musl (needed for the x86_64-unknown-linux-musl remote_server build) and mold.
ARCH_DEPS=(
  gcc clang musl mold cmake alsa-lib fontconfig glib2 libva wayland libgit2
  libxcb libxkbcommon-x11 openssl zstd pkgconf sqlite pipewire
  xdg-desktop-portal vulkan-icd-loader jq git
)

bootstrap_packages() {
  command -v pacman >/dev/null 2>&1 || {
    warn "not an Arch-family system; run script/linux yourself for your distro"
    return 0
  }
  local missing=()
  for p in "${ARCH_DEPS[@]}"; do
    pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  if [ ${#missing[@]} -eq 0 ]; then
    msg "system packages: all present"
    return 0
  fi
  msg "installing: ${missing[*]}"
  sudo pacman -S --needed --noconfirm "${missing[@]}"
}

bootstrap_rust() {
  command -v rustup >/dev/null 2>&1 ||
    die "rustup not found; install it, then re-run (rust-toolchain.toml pins the version)"
  # Reading the pinned toolchain is enough to make rustup install it, along with
  # the wasm and musl targets rust-toolchain.toml declares.
  msg "rust toolchain: $(rustc --version)"
  rustup target list --installed | sed 's/^/    /'
}

# Writing a malformed sccache config breaks EVERY compile, not just the cache:
# the client reads it on each rustc invocation and exits non-zero with
# "Failed to load config file". So write through a backup and roll back if the
# result does not parse.
bootstrap_sccache() {
  command -v "$SCCACHE_BIN" >/dev/null 2>&1 || {
    warn "$SCCACHE_BIN not found; skipping cache setup"
    return 0
  }
  if build_running; then
    warn "a build is running; skipping sccache config (a bad config would fail it mid-flight)"
    return 0
  fi

  mkdir -p "$(dirname "$SCCACHE_CONF_FILE")" "$SCCACHE_DIR"
  local backup="" tmp
  [ -f "$SCCACHE_CONF_FILE" ] && { backup="$SCCACHE_CONF_FILE.bak"; cp "$SCCACHE_CONF_FILE" "$backup"; }
  tmp=$(mktemp)

  # basedirs is a TOP-LEVEL key. Put it after a [section] header and TOML reads
  # it as a field of that table, sccache rejects the whole file, and every
  # compile fails until it is fixed.
  cat > "$tmp" <<EOF
# sccache local disk cache. Written by zed-cb bootstrap.
#
# FILENAME: sccache reads ~/.config/sccache/config, with no extension. A
# sibling config.toml is never loaded.
#
# ORDERING: basedirs is a top-level key and must appear before the first
# [section] header, or the file fails to parse and every compile fails with
# "sccache: error: Failed to load config file".

# Strips these prefixes from source paths when computing the cache key, so the
# same crate built from a different checkout, git worktree, or copy still hits.
basedirs = $SCCACHE_BASEDIRS

[cache.disk]
dir = "$SCCACHE_DIR"
# Zed alone pulls ~1500 crates, and one full set of cached objects for a single
# flag combination runs several GB; at the 10 GiB default Zed's dep tree is
# evicted before the next build can reuse it.
size = $SCCACHE_SIZE_BYTES
EOF

  mv "$tmp" "$SCCACHE_CONF_FILE"
  "$SCCACHE_BIN" --stop-server >/dev/null 2>&1 || true

  if "$SCCACHE_BIN" --show-stats 2>&1 | grep -q "Failed to load config"; then
    if [ -n "$backup" ]; then
      mv "$backup" "$SCCACHE_CONF_FILE"
      "$SCCACHE_BIN" --stop-server >/dev/null 2>&1 || true
      "$SCCACHE_BIN" --show-stats >/dev/null 2>&1 || true
      die "new sccache config did not parse; restored the previous one"
    fi
    rm -f "$SCCACHE_CONF_FILE"
    die "new sccache config did not parse; removed it"
  fi

  [ -n "$backup" ] && rm -f "$backup"
  msg "sccache: $("$SCCACHE_BIN" --show-stats | grep 'Max cache size' | tr -s ' ')"
  [ -f "$HOME/.config/sccache/config.toml" ] &&
    warn "~/.config/sccache/config.toml exists and is NOT read by sccache; delete it to avoid confusion"

  grep -q "rustc-wrapper" "$HOME/.cargo/config.toml" 2>/dev/null ||
    warn "~/.cargo/config.toml has no rustc-wrapper; add [build] rustc-wrapper = \"$SCCACHE_BIN\" to cache every Rust project"
  return 0
}

bootstrap_remotes() {
  need_src
  git remote get-url upstream >/dev/null 2>&1 || {
    git remote add upstream "$UPSTREAM_URL"
    msg "added upstream -> $UPSTREAM_URL"
  }
  git remote -v | sed 's/^/    /'
}

bootstrap_link_self() {
  mkdir -p "$PREFIX/bin"
  if [ "$(readlink -f "$PREFIX/bin/$CLI_NAME" 2>/dev/null)" != "$SELF" ]; then
    ln -sfn "$SELF" "$PREFIX/bin/$CLI_NAME"
    msg "$PREFIX/bin/$CLI_NAME -> $SELF"
  fi
  case ":$PATH:" in
    *":$PREFIX/bin:"*) ;;
    *) warn "$PREFIX/bin is not on PATH" ;;
  esac
}

cmd_bootstrap() {
  bootstrap_packages
  bootstrap_rust
  bootstrap_sccache
  mkdir -p "$CARGO_TARGET_DIR"
  msg "target dir: $CARGO_TARGET_DIR"
  bootstrap_remotes
  bootstrap_link_self
  msg "bootstrap done -- 'zed-cb build' then 'zed-cb install'"
}

# ------------------------------------------------------------------ commands --

cmd_doctor() {
  need_src
  echo "source        $SRC"
  echo "branch        $(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)"
  echo "channel       $(cat crates/zed/RELEASE_CHANNEL)"
  echo "zed version   $(script/get-crate-version zed 2>/dev/null || echo '?')"
  echo "toolchain     $(rustc --version)"
  echo "jobs          $CARGO_BUILD_JOBS"
  echo "rustflags     $HOST_RUSTFLAGS_VAR=$HOST_RUSTFLAGS"
  echo "target dir    $CARGO_TARGET_DIR ($(target_dir_gb) GB, cap ${TARGET_CAP_GB} GB)"
  echo "installed     $("$APP_DIR/bin/zed" --version 2>/dev/null || echo 'not installed')"
  echo
  echo "tools:"
  for b in mold clang llvm-objcopy musl-gcc jq envsubst rustup; do
    printf '  %-14s %s\n' "$b" "$(command -v "$b" || echo MISSING)"
  done
  # cargo resolves subcommands out of ~/.cargo/bin itself, so command -v misses it.
  printf '  %-14s %s\n' "cargo-about" "$(cargo about --version 2>/dev/null || echo 'MISSING (bundle-linux installs it)')"
  echo
  echo "rust targets:"
  rustup target list --installed | sed 's/^/  /'
  echo
  "$SCCACHE_BIN" --show-stats 2>/dev/null |
    grep -E 'Cache hits|Cache misses|hits rate|Cache size|Max cache size|Base directories' | sed 's/^/  /'
  echo
  df -h "$CARGO_TARGET_DIR" "$SCCACHE_DIR" 2>/dev/null | sed 's/^/  /'
}

# Local commits on main (this script, for one) are rebased onto upstream/main
# rather than treated as an error. Only this fork's own main is rewritten, and
# the push uses --force-with-lease so a surprise remote change aborts it.
cmd_sync() {
  need_src
  git remote get-url upstream >/dev/null 2>&1 || git remote add upstream "$UPSTREAM_URL"
  msg "fetching upstream"
  git fetch upstream --tags --prune

  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  [ "$branch" = "main" ] || die "on branch '$branch'; switch to main to sync"
  [ -z "$(git status --porcelain)" ] || die "working tree is dirty; commit or stash first"

  local ahead
  ahead=$(git rev-list --count upstream/main..HEAD)
  if [ "$ahead" -eq 0 ]; then
    msg "fast-forwarding main to upstream/main"
    git merge --ff-only upstream/main
    git push origin main
  else
    msg "main has $ahead local commit(s); rebasing onto upstream/main"
    git rebase upstream/main
    msg "pushing (force-with-lease, this fork's main only)"
    git push --force-with-lease origin main
  fi
}

cmd_run() {
  need_src
  msg "debug build + run (target: $CARGO_TARGET_DIR)"
  cargo run "$@"
}

cmd_build() {
  need_src
  need_current_bundle_script
  local used t0
  used=$(target_dir_gb)
  [ "$used" -gt "$TARGET_CAP_GB" ] &&
    warn "target dir is ${used} GB (cap ${TARGET_CAP_GB} GB); 'zed-cb clean' frees it"
  build_running && die "another build is already running (pid $(cat "$BUILD_LOCK"))"
  mkdir -p "$CARGO_TARGET_DIR"
  echo $$ > "$BUILD_LOCK"
  trap 'rm -f "$BUILD_LOCK"' EXIT

  msg "release bundle, $CARGO_BUILD_JOBS jobs, mold linker, sccache on"
  t0=$SECONDS
  script/bundle-linux
  msg "built in $(( (SECONDS - t0) / 60 ))m$(( (SECONDS - t0) % 60 ))s"
  ls -lh "$CARGO_TARGET_DIR/release"/zed*-linux-*.tar.gz
}

cmd_install() {
  need_src
  local archive src_desktop icon size
  archive=$(ls -t "$CARGO_TARGET_DIR/release"/zed*-linux-"$(uname -m)".tar.gz 2>/dev/null | head -1)
  [ -n "$archive" ] || die "no bundle found; run 'zed-cb build' first"
  msg "installing $(basename "$archive")"

  rm -rf "$APP_DIR"
  mkdir -p "$PREFIX"
  tar -xzf "$archive" -C "$PREFIX"
  [ -x "$APP_DIR/bin/zed" ] || die "expected $APP_DIR/bin/zed after unpacking $archive"

  mkdir -p "$PREFIX/bin" "$PREFIX/share/applications" \
           "$PREFIX/share/icons/hicolor/512x512/apps" \
           "$PREFIX/share/icons/hicolor/1024x1024/apps"

  ln -sfn "$APP_DIR/bin/zed" "$PREFIX/bin/$CLI_NAME-run"

  for size in 512x512 1024x1024; do
    icon="$APP_DIR/share/icons/hicolor/$size/apps/zed.png"
    [ -f "$icon" ] && cp -f "$icon" "$PREFIX/share/icons/hicolor/$size/apps/zed-cb.png"
  done

  # The bundled .desktop says Exec=zed, which resolves on PATH to whatever `zed`
  # happens to be. Point it at this build explicitly, and give the icon a
  # distinct name so it cannot overwrite another channel's.
  src_desktop=$(ls "$APP_DIR"/share/applications/*.desktop | head -1)
  sed -e "s|^TryExec=.*|TryExec=$APP_DIR/bin/zed|" \
      -e "s|^Exec=zed |Exec=$APP_DIR/bin/zed |" \
      -e "s|^Exec=zed$|Exec=$APP_DIR/bin/zed|" \
      -e "s|^Icon=.*|Icon=zed-cb|" \
      "$src_desktop" > "$PREFIX/share/applications/dev.zed.Zed-Dev.desktop"
  chmod +x "$PREFIX/share/applications/dev.zed.Zed-Dev.desktop"

  command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$PREFIX/share/applications" 2>/dev/null || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -f -t "$PREFIX/share/icons/hicolor" 2>/dev/null || true

  msg "installed: $("$APP_DIR/bin/zed" --version 2>/dev/null || echo "$APP_DIR")"
  msg "launch with: $CLI_NAME-run   (or 'zed-cb link-default' to claim zed/zeditor)"
}

# `zeditor` is the name the Arch package used; ~/.bash_aliases, ~/.bash_functions
# and ~/.config/zed/tasks.json all still call it.
cmd_link_default() {
  [ -x "$APP_DIR/bin/zed" ] || die "nothing installed at $APP_DIR; run 'zed-cb install' first"
  local name
  for name in zed zeditor; do
    ln -sfn "$APP_DIR/bin/zed" "$PREFIX/bin/$name"
    msg "$PREFIX/bin/$name -> $APP_DIR/bin/zed"
  done
}

cmd_update() { cmd_sync; cmd_build; cmd_install; }

cmd_stats() { "$SCCACHE_BIN" --show-stats; }

cmd_clean() {
  msg "target dir is $(target_dir_gb) GB at $CARGO_TARGET_DIR"
  read -r -p "remove it? cargo rebuilds everything sccache cannot serve [y/N] " reply
  case "$reply" in
    [yY]*) rm -rf "$CARGO_TARGET_DIR"; msg "removed" ;;
    *) msg "kept" ;;
  esac
}

case "${1:-}" in
  bootstrap)    shift; cmd_bootstrap "$@" ;;
  doctor)       shift; cmd_doctor "$@" ;;
  sync)         shift; cmd_sync "$@" ;;
  run)          shift; cmd_run "$@" ;;
  build)        shift; cmd_build "$@" ;;
  install)      shift; cmd_install "$@" ;;
  update)       shift; cmd_update "$@" ;;
  link-default) shift; cmd_link_default "$@" ;;
  stats)        shift; cmd_stats "$@" ;;
  clean)        shift; cmd_clean "$@" ;;
  *) sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
